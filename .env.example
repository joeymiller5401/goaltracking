# Copy these into your Netlify site's Environment variables
# (Site settings -> Environment variables). NEVER commit real values.

# Neon Postgres connection string (use the POOLED connection string).
# Create a free database at https://neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 256-bit key for field encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 32 bytes, supplied as base64 (or 64 hex chars). KEEP THIS SECRET AND BACKED UP:
# if you lose it, encrypted data cannot be recovered.
FIELD_ENCRYPTION_KEY="paste-generated-32-byte-base64-key"

# Secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="paste-long-random-string"

# Shared code required to create an account. Distribute only to your team.
# Without this set, registration is disabled entirely.
SIGNUP_CODE="choose-a-team-signup-code"
